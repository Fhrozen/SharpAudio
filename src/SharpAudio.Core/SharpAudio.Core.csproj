<!-- wiki: worker-core#core-project-layout -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Lets the per-task protos import common.proto (relative to the project). -->
    <AdditionalProtoPaths>Protos</AdditionalProtoPaths>
  </PropertyGroup>

  <!-- Core owns WorkerHost, so it needs the ASP.NET pipeline (Kestrel + DI + logging),
       not just a plain library reference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
    <PackageReference Include="Grpc.Tools" Version="2.66.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="NumSharp" Version="0.30.0" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both: Core is the single source of the generated contract, so the API resolves
         clients and the worker executables resolve servers from the same assembly.
         common.proto is compiled as a shared message-only contract. -->
    <Protobuf Include="Protos/synthesis.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/transcription.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/common.proto" GrpcServices="None" />
    <Protobuf Include="Protos/music.proto" GrpcServices="Both" />
    <Protobuf Include="Protos/diarization.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
