# wiki: docker-packaging#image-stages
FROM mcr.microsoft.com/dotnet/sdk:10.0-preview AS build
WORKDIR /src

# Install espeak-ng (Kokoro TTS), libgomp1 (Whisper.net's native ggml-cpu library needs OpenMP),
# and ffmpeg (audio format normalization for ASR, see AudioFormatConverterTests)
RUN apt-get update && \
    apt-get install -y libespeak-ng1 espeak-ng-data libgomp1 ffmpeg && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy solution and project files
COPY SharpAudio.slnx ./
COPY src/SharpAudio.Core/SharpAudio.Core.csproj src/SharpAudio.Core/
COPY src/SharpAudio.Api/SharpAudio.Api.csproj src/SharpAudio.Api/
COPY tests/SharpAudio.Api.Tests/SharpAudio.Api.Tests.csproj tests/SharpAudio.Api.Tests/
COPY tests/SharpAudio.Api.IntegrationTests/SharpAudio.Api.IntegrationTests.csproj tests/SharpAudio.Api.IntegrationTests/

# Restore all projects
RUN dotnet restore src/SharpAudio.Api/SharpAudio.Api.csproj
RUN dotnet restore tests/SharpAudio.Api.Tests/SharpAudio.Api.Tests.csproj
RUN dotnet restore tests/SharpAudio.Api.IntegrationTests/SharpAudio.Api.IntegrationTests.csproj

# Copy all source files
COPY src/ src/
COPY tests/ tests/

# Build and run tests
WORKDIR /src
ENV ESPEAK_DATA_DIR=/app/assets/espeak-ng-data
# Note: /app/assets should be mounted as a volume with espeak-ng-data
ENTRYPOINT ["dotnet", "test", "--logger:console;verbosity=detailed", "--no-restore"]
CMD ["tests/SharpAudio.Api.IntegrationTests/SharpAudio.Api.IntegrationTests.csproj"]
